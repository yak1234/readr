<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine, and the bundled Python's PyTorch and MLX, compile code as they run. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The bundled Python loads hundreds of third-party libraries (its packages' compiled parts). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- News sites, radio and TV streams; the helpers answer on this computer only (127.0.0.1). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
