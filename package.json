{
  "name": "readr",
  "productName": "Readr",
  "version": "0.1.0",
  "description": "Read, listen and watch in the language you're learning, with translation, a dictionary and flashcards.",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,app -c blue,yellow,green \"vite\" \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && electron tests/e2e/harness.js && electron tests/e2e/upgrade-harness.js && electron tests/e2e/review-harness.js && electron tests/e2e/cards-harness.js && electron tests/e2e/source-harness.js && electron tests/e2e/add-source-harness.js && electron tests/e2e/tv-harness.js && electron tests/e2e/check-harness.js",
    "dist": "npm run build && electron-builder",
    "postinstall": "node -e \"process.platform === 'darwin' && require('node:child_process').execFileSync('zsh', ['scripts/dev-app.sh'], { stdio: 'inherit' })\"",
    "runtime": "node scripts/build-runtime.mjs",
    "dist:mac": "npm run build && npm run runtime && electron-builder --mac --arm64",
    "smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-context-menu": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "kysely": "^0.29.8",
    "p-queue": "^10.0.0",
    "p-wait-for": "^7.0.0",
    "tldts": "^7.4.19",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@react-hook/resize-observer": "^2.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sparkle.readr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "*.py",
          "!test_*.py",
          "!conftest.py",
          "!check_translation.py"
        ]
      },
      {
        "from": "shared/languages.json",
        "to": "shared/languages.json"
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!MANIFEST.json"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "signIgnore": [
        "/Contents/Resources/runtime/models/",
        "/Contents/Resources/runtime/dictionaries/"
      ]
    },
    "dmg": {
      "title": "Readr ${version}",
      "format": "ULFO"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    }
  }
}
